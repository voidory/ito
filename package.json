{
  "name": "ito",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Research PDF reader + source-local annotation + deliberate subject pages + concept network.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
