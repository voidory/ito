    "koofr-probe": "node scripts/koofr-probe.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.0",
    "pdfjs-dist": "^4.7.76",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.23.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.34.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
